def example = {
    let lst = []
        |+ Left  0
        |+ Both  1 'a'
        |+ Right   'b'
        :+ Both  2 'c'

    let xys :+ xy = lst
    let mut xs = []
    let mut ys = []

    # accumulate seperately
    xys.iter fn
        | Both x y => {
            xs.push x
            ys.push y
        }
        | Left x   => xs.push x
        | Right y  => ys.push y

    # handle end
    match xy with
        | Both x y => Both (xs :+ x) (ys :+ y)
        | Left x   => if ys.as_nonempty is Some ys
            do Both (xs :+ x) ys
            else Left (xs :+ x)
        | Right y  => if xs.as_nonempty is Some xs
            do Both xs (ys :+ y)
            else Right (ys :+ y)
}